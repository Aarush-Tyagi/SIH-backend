# =============================================================================
# WeatherGPT Backend — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Phase 0: Core ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Phase 1: Weather Data ---
# Free signup: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Phase 2: Vector DB ---
# The MVP uses the in-process JSON store; this is reserved for a Qdrant swap.
QDRANT_URL=http://localhost:6333

# --- Phase 3: LLM ---
# Free signup (no credit card): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Phase 4: Translation (optional — falls back to deep-translator) ---
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_KEY=

# --- Phase 5: WhatsApp (optional — Phase 5 only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: protects GET /api/alerts/subscriptions
ADMIN_API_KEY=

# --- Phase 6: Database ---
DATABASE_URL=sqlite+aiosqlite:///./weathergpt.db
